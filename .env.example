# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Host & Port configuration for Cloud Run / Container deployment
HOST="0.0.0.0"
PORT="3000"

# Explicit public domain URL (overrides auto-detection from APP_URL / SERVICE_URL)
PUBLIC_DOMAIN_URL=""

# Server-side User ID and Password to access the website GUI (e.g. on https://kiroproxy.ai.studio/)
GATEWAY_ADMIN_USER="admin"
GATEWAY_ADMIN_PASSWORD="kiroproxy2026"

# Optional security token for public AI Studio published domain protection (Kiro IDE patcher /k/<token>)
PROXY_ADMIN_TOKEN=""

# Provider Priority Order (comma-separated tier: custom,gemini,openrouter,kilo,cline,canvas)
PROVIDER_PRIORITY_ORDER="gemini,custom,openrouter,canvas"

# Stateless container custom providers JSON string (preserves configs across cold container boots)
CUSTOM_PROVIDERS_JSON="[]"

# Optional local ngrok auth token (used when running locally to expose localhost for Gemini Canvas)
NGROK_AUTHTOKEN=""
